# ─────────────────────────────────────────────────────────────
# BirthNote — copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for Stripe redirects, emails, sitemap)
NEXT_PUBLIC_SITE_URL=https://birthnote.com

# ── MySQL / MariaDB (Hostinger hPanel → Databases → Management) ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u123456789_birthnote
MYSQL_USER=u123456789_birthnote
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5

# ── Stripe (dashboard.stripe.com/apikeys) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── SMTP (Gmail: use an App Password, not your account password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
MAIL_FROM="BirthNote <you@gmail.com>"
MAIL_REPLY_TO=you@gmail.com
# Leave blank to disable sending and log emails to the server console instead
MAIL_ENABLED=true

# ── Admin panel ──
# Admins are real accounts in the admin_users table, managed at /admin/users.
# These three are used ONCE, by `npm run db:migrate`, to create the first owner
# account when admin_users is empty — without them a fresh deploy would have no
# way in. They are ignored on every later run, so changing ADMIN_PASSWORD here
# does not change anyone's password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Owner

# Customer accounts need no secret of their own: their session cookie holds a
# random token whose hash is stored in the user_sessions table, so there is
# nothing to sign.

# ── Pricing ──
# Order total in paise (the minor unit of INR): 249900 = ₹2,499.
BANKNOTE_PRICE_PAISE=249900
