# ─────────────────────────────────────────────────────────────
# My Lucky Dates — copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for emails, invoices, sitemap)
NEXT_PUBLIC_SITE_URL=https://birthnote.com

# ── MySQL / MariaDB (Hostinger hPanel → Databases → Management) ──
# The schema is created and migrated automatically when the app starts
# (src/server/migrations). Set MIGRATE_ON_BOOT=false to skip that step.
# MIGRATE_ON_BOOT=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u123456789_myluckydates
MYSQL_USER=u123456789_myluckydates
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5

# ── PhonePe (business.phonepe.com → Developer Settings → API Keys) ──
# All five are secret. PhonePe hosts the payment page itself, so unlike the
# gateway this replaced nothing here is ever sent to the browser — do not make
# any of them NEXT_PUBLIC_.
# CLIENT_VERSION is issued by PhonePe alongside the id and secret; it is not a
# version of ours and the wrong value fails the token request outright.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# sandbox | production. Sandbox payments look perfect and settle nothing, and
# PhonePe credentials carry no mark saying which they are — so this is stated,
# not inferred, and /api/health reports what it was set to. Defaults to sandbox.
PHONEPE_ENV=sandbox
# A DIFFERENT pair from the credentials above: whatever you type into
# business.phonepe.com → Developer Settings → Webhooks when adding the endpoint
# at https://your-domain/api/webhooks/phonepe. Subscribe it to
# checkout.order.completed, checkout.order.failed, pg.refund.completed and
# pg.refund.failed.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ── SMTP (Gmail: use an App Password, not your account password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
MAIL_FROM="My Lucky Dates <you@gmail.com>"
MAIL_REPLY_TO=you@gmail.com
# Leave blank to disable sending and log emails to the server console instead
MAIL_ENABLED=true

# ── Admin panel ──
# Admins are real accounts in the admin_users table, managed at /admin/users.
# These three are used ONCE, when the server starts, to create the first owner
# account when admin_users is empty — without them a fresh deploy would have no
# way in. They are ignored on every later start, so changing ADMIN_PASSWORD here
# does not change anyone's password.
ADMIN_EMAIL=rpreethi.sundarrajan@gmail.com
ADMIN_PASSWORD=A^s5$00DG>&
ADMIN_NAME=Owner

# Customer accounts need no secret of their own: their session cookie holds a
# random token whose hash is stored in the user_sessions table, so there is
# nothing to sign.

# ── WhatsApp (Meta Cloud API) ──
# Business-initiated messages must use templates Meta has approved in advance.
# Create them at business.facebook.com → WhatsApp Manager → Message templates,
# with the names below and the placeholders documented in
# docs/phase-5-pwa-whatsapp.md. Leave WHATSAPP_ACCESS_TOKEN blank to log
# messages to the console instead of sending them.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Only change this to point at a proxy or a test stub.
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_LANGUAGE=en
# A bare 10-digit number is assumed to be in this country.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_RECEIVED=order_received
WHATSAPP_TEMPLATE_CONFIRMED=order_confirmed
WHATSAPP_TEMPLATE_UNAVAILABLE=order_unavailable
WHATSAPP_TEMPLATE_PAID=order_paid
WHATSAPP_TEMPLATE_SHIPPED=order_shipped

# ── Shiprocket (app.shiprocket.in) ──
# There are no API keys: the app posts these to /auth/login and caches the
# bearer token it gets back (about ten days) in app_settings, because repeated
# logins are throttled hard. Use a dedicated API user if you have one.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Whatever you type into Shiprocket → Settings → API → Webhooks when pointing
# it at https://your-domain/api/webhooks/shiprocket. They send it back as an
# x-api-key header. Not a signature: it authenticates the caller, not the body.
SHIPROCKET_WEBHOOK_TOKEN=
#
# The pickup location, parcel weight and dimensions are NOT set here — they
# live in /admin/settings so the owner can change them without a deploy. The
# pickup address is chosen from a dropdown fetched live from the Shiprocket
# account, so it cannot be mistyped; the address must be registered AND
# approved there first. /api/health reports whether it has been set.

# ── Manual reconciliation (optional) ──
# Reconciliation — asking PhonePe about payments it completed but never told us
# about — normally runs off ordinary traffic, at most once every 15 minutes.
# See src/server/background-sweep.ts. NOTHING here needs configuring for that.
#
# This secret only guards /api/cron/sweep, which forces a run on demand. Set it
# if you want to trigger one by hand, or point a real cron at it on a site too
# quiet to rely on passing visitors. Leave it unset and that endpoint refuses
# every request — it never runs open.
#   openssl rand -hex 32
CRON_SECRET=

# ── Pricing ──
# Order total in paise (the minor unit of INR): 249900 = ₹2,499.
BANKNOTE_PRICE_PAISE=249900

# ── SMS one-time codes (MSG91) ──
# Customers sign in with a code sent to their mobile number, or by email to
# their address (that path uses the SMTP block above and needs nothing here).
# The code itself is generated, hashed and verified by My Lucky Dates — MSG91 only
# delivers it — so swapping providers later touches one file, src/lib/sms.ts.
#
# Where each value comes from in the MSG91 dashboard (control.msg91.com):
#   MSG91_AUTH_KEY    — Settings → API → Auth Key
#   MSG91_TEMPLATE_ID — SMS → Templates: the DLT-approved OTP template. Its
#                       body must contain the ##OTP## variable, e.g.
#                       "##OTP## is your My Lucky Dates verification code."
#   MSG91_SENDER_ID   — the 6-character DLT-approved header, e.g. BRTHNT.
#                       Optional: leave blank to use the template's own sender.
#
# Leave MSG91_AUTH_KEY blank and codes are printed to the server console
# instead of sent, so sign-in works locally without spending money on SMS.
MSG91_ENABLED=true
MSG91_AUTH_KEY=521763AJNkOkL1CTn6a8953cfP1
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# Only change this to point at a proxy or a test stub.
MSG91_API_BASE=https://control.msg91.com
# Shown in MSG91's message text. Keep it equal to AUTH_OTP_TTL_SECONDS below,
# or the SMS will promise a different expiry than the one enforced.
MSG91_OTP_EXPIRY_MINUTES=10

# ── Sign-in behaviour ──
# A bare 10-digit number is assumed to be in this country.
NEXT_PUBLIC_AUTH_DEFAULT_COUNTRY_CODE=91
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=45
